{
	"manifest_version": 3,
	"name": "InstaTab",
	"version": "1.1.0",
	"description": "Open instagram images in a new tab.",
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"192": "icon192.png",
		"512": "icon512.png"
	},
	"content_scripts": [
		{
			"js": [
				"content.js"
			],
			"matches": [
				"https://www.instagram.com/*"
			]
		}
	]
}