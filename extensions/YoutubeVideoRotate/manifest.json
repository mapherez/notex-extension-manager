{
  "manifest_version": 3,
  "name": "YouTube Video Rotate",
  "version": "1.0.0",
  "description": "Add a button to the YouTube player to rotate videos in normal, cinema, and fullscreen modes.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/shorts/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}